<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Telephony & VoIP Permissions -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    
    <!-- Audio & Hardware -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Real QR scanning (Scan Hub > QR Code Scanner). CameraX + ZXing. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Notifications & Full Screen Alerts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- Foreground Service (Android 14 API 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    
    <!-- Networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    
    <!-- Storage -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    
    <!-- Boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Hardware Features -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />
    
    <!-- Queries for Android 11+ Package Visibility -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".RakshakSetuApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight"
        android:extractNativeLibs="true">

        <!-- Main Host Activity (Launcher, Dialer Keypad & Live In-Call Threat HUD) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Material3.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Evidence Dossier Activity -->
        <!-- exported=false: renders forensic dossiers containing call transcripts.
             exported="true" let any app on the device launch it and read the result. -->
        <activity
            android:name=".ui.EvidenceActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.DayNight" />

        <!-- Government Reporting Assistant (NCRP / Chakshu guided WebView) -->
        <!-- exported=false: navigated to only from inside the app; no external entry
             point is required, and exporting a WebView to other apps is a known risk. -->
        <activity
            android:name=".ui.GovtReportWebViewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:usesCleartextTraffic="false"
            android:theme="@style/Theme.Material3.DayNight" />

        <!-- Continuous 24/7 Shield ForegroundService -->
        <service
            android:name=".service.RakshakShieldService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous call scam protection shield and background telephony monitoring" />
        </service>

        <!-- Analysis ForegroundService -->
        <service
            android:name=".service.AnalysisService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Post-call audio analysis for scam detection" />
        </service>

        <!-- Native Telecom ConnectionService (Self-Managed VoIP Provider) -->
        <service
            android:name="com.rakshaksetu.app.telecom.RakshakConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:foregroundServiceType="microphone|phoneCall"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- Active Call Foreground Service (Android 14 phoneCall|microphone) -->
        <service
            android:name="com.rakshaksetu.app.telecom.CallForegroundService"
            android:foregroundServiceType="phoneCall|microphone"
            android:exported="false" />

        <!-- Telephony BroadcastReceiver -->
        <receiver
            android:name=".telephony.CallStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Boot Completed Receiver -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Not-a-Scam Feedback Receiver -->
        <receiver
            android:name=".receiver.FeedbackReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.rakshaksetu.app.ACTION_NOT_SCAM" />
            </intent-filter>
        </receiver>

        <!-- Elder Mode one-tap family alert + SMS delivery intents -->
        <receiver
            android:name=".receiver.ElderAlertReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.rakshaksetu.app.ACTION_ALERT_FAMILY" />
                <action android:name="com.rakshaksetu.app.ACTION_ELDER_SMS_SENT" />
            </intent-filter>
        </receiver>

    </application>
</manifest>

